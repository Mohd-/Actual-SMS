{
  "name": "tasker-actual-sms",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "setup": "sh scripts/setup-docker.sh",
    "setup:host": "node --import tsx src/setup.ts",
    "smoke:actual": "node --import tsx scripts/smoke-actual.ts",
    "management:password": "node --import tsx src/management/password.ts",
    "test:web": "npm run build && node --import tsx scripts/smoke-management.ts",
    "smoke:disposable": "npm run build && node dist/scripts/smoke-disposable.js"
  },
  "dependencies": {
    "@actual-app/api": "26.11.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/secure-session": "^8.4.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.12.8",
    "luxon": "^3.7.1",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.17.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
