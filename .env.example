API_KEY=replace-with-at-least-16-random-characters
ACTUAL_SERVER_URL=http://actual-server:5006
ACTUAL_PASSWORD=replace-me
ACTUAL_SYNC_ID=replace-me
ACTUAL_ENCRYPTION_PASSWORD=
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=deepseek-v4-flash
CONFIG_PATH=/config/accounts.yaml
BANKS_CONFIG_PATH=/config/banks.yaml
PARSING_CONFIG_PATH=/config/parsing.yaml
DB_PATH=/data/events.sqlite
ACTUAL_CACHE_DIR=/actual-cache
PORT=3000
LOG_LEVEL=info
MAX_ATTEMPTS=5
ENRICHMENT_MIN_CONFIDENCE=0.70
MAPPING_REFRESH_MINUTES=60

# Optional management UI at /manage. Existing headless setup needs none of these.
MANAGEMENT_ENABLED=0
MANAGEMENT_EDIT_ACCOUNTS=0
# Exact HTTPS origin (HTTP allowed only on loopback); no trailing slash or path.
# MANAGEMENT_URL=https://sms.example.test
# Generate with npm run management:password; keep the single quotes in .env.
# MANAGEMENT_PASSWORD_HASH='$2b$12$replace-with-generated-bcrypt-hash'
# Independent 32-byte hex key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MANAGEMENT_SECRET=replace-with-generated-64-hex-characters
